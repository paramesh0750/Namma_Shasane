<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Profile"
            android:layout_marginTop="20dp"/>

        <!-- APP TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Namma Shasane"
            android:textStyle="bold"
            android:textSize="32sp"
            android:textColor="#222222"
            android:layout_marginBottom="20dp"/>

        <!-- PHOTO TAG CARD -->
        <LinearLayout
            android:id="@+id/cardPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="30dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Photo Tag"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#333333"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capture and tag public issues"
                android:textSize="18sp"
                android:textColor="#777777"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"/>

        </LinearLayout>

        <!-- ABOUT SECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About Namma Shasane"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#333333"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Namma Shasane is a smart civic reporting platform that helps users capture, identify, and share public information through photo tagging, AI-based story generation, location mapping, and alert features."
                android:textSize="18sp"
                android:textColor="#666666"
                android:lineSpacingExtra="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✔ Smart Photo Tagging"
                android:textSize="18sp"
                android:textColor="#333333"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✔ Real-time Alert System"
                android:textSize="18sp"
                android:textColor="#333333"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✔ Location-based Reporting"
                android:textSize="18sp"
                android:textColor="#333333"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!-- FEATURES SECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Platform Features"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#333333"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 AI Heritage Detection"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺 Interactive Map Support"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📢 Authority Alert Reporting"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Camera + Gallery Support"
                android:textSize="18sp"/>

        </LinearLayout>

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart reporting for better communication"
            android:textStyle="italic"
            android:textSize="18sp"
            android:textColor="#888888"
            android:gravity="center"
            android:padding="20dp"/>

    </LinearLayout>

</ScrollView>